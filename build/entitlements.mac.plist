<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the app may do under macOS's hardened runtime. Kept to the minimum:
   - allow-jit: Electron's JavaScript engine (V8) compiles code as it runs.
  Nothing else: no camera, microphone, contacts, or loading other people's
  code libraries. (Receiving Art-Net needs no entitlement outside the App Store
  sandbox; macOS asks the user once for Local Network access, see Info.plist.)
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
